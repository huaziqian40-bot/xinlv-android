<?xml version="1.0" encoding="utf-8"?>
<!-- phix 首启引导页（CONTRACT §7）：询问→登录/注册/跳过 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- 询问标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已有 phix 会话凭据吗？"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/transparent"
            android:layout_marginTop="32dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="phix 是统一账号系统，登录后记录可跨设备同步"
            android:textSize="13sp"
            android:textColor="@android:color/transparent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <!-- 表单卡片 -->
        <LinearLayout
            android:id="@+id/formCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- 服务器地址（登录/注册时显示） -->
            <TextView
                android:id="@+id/labelServer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="服务器地址"
                android:textSize="13sp"
                android:textColor="@android:color/transparent"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etServer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="http://192.168.5.41:8931"
                android:textSize="14sp"
                android:inputType="textUri"
                android:singleLine="true"
                android:padding="10dp"
                android:background="@android:color/transparent"
                android:textColor="@android:color/transparent"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- 账号（登录/注册时显示） -->
            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="账号"
                android:textSize="14sp"
                android:inputType="text"
                android:singleLine="true"
                android:padding="10dp"
                android:background="@android:color/transparent"
                android:textColor="@android:color/transparent"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- 密码（登录/注册时显示） -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="密码"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:singleLine="true"
                android:padding="10dp"
                android:background="@android:color/transparent"
                android:textColor="@android:color/transparent"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- 确认密码（仅注册时显示） -->
            <EditText
                android:id="@+id/etPassword2"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="再输一遍密码"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:singleLine="true"
                android:padding="10dp"
                android:background="@android:color/transparent"
                android:textColor="@android:color/transparent"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- 按钮区 -->
            <Button
                android:id="@+id/btnHave"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="有，去登录"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:textColor="@android:color/transparent"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnNone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="没有，去注册"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:textColor="@android:color/transparent"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="提交"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:textColor="@android:color/transparent"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="返回"
                android:textSize="14sp"
                android:background="@android:color/transparent"
                android:textColor="@android:color/transparent"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 状态文本 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@android:color/transparent"
            android:gravity="center"
            android:visibility="gone" />

        <!-- 跳过链接 -->
        <TextView
            android:id="@+id/tvSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="跳过，稍后再说"
            android:textSize="14sp"
            android:textColor="@android:color/transparent"
            android:padding="8dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
