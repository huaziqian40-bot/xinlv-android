<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:clipChildren="false">

    <!-- ========= 上半部分：日历网格（固定大小，不可滚动）= wrap_content 随正方形格子撑开 ========= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 月份导航 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="2dp"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="‹"
                android:textSize="22sp"
                android:gravity="center"
                android:padding="0dp"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="›"
                android:textSize="22sp"
                android:gravity="center"
                android:padding="0dp"
                android:textColor="@color/ink" />
        </LinearLayout>

        <!-- 视图切换标签 -->
        <LinearLayout
            android:id="@+id/viewTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="0dp">

            <TextView
                android:id="@+id/btnViewMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="3dp"
                android:text="月"
                android:textSize="14sp"
                android:textColor="@color/ink_soft"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnViewWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="3dp"
                android:text="周"
                android:textSize="14sp"
                android:textColor="@color/ink_soft"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnViewYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="3dp"
                android:text="年"
                android:textSize="14sp"
                android:textColor="@color/ink_soft"
                android:gravity="center" />
        </LinearLayout>

        <!-- 同步状态条 -->
        <TextView
            android:id="@+id/tvSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="2dp"
            android:textColor="@color/ink_soft"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- ========= 月视图 ========= -->
        <LinearLayout
            android:id="@+id/paneMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 星期表头 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">
                <TextView style="@style/WeekHeader" android:text="一" />
                <TextView style="@style/WeekHeader" android:text="二" />
                <TextView style="@style/WeekHeader" android:text="三" />
                <TextView style="@style/WeekHeader" android:text="四" />
                <TextView style="@style/WeekHeader" android:text="五" />
                <TextView style="@style/WeekHeader" android:text="六" />
                <TextView style="@style/WeekHeader" android:text="日" />
            </LinearLayout>

            <!-- 日历网格 -->
            <com.moodtree.app.ui.SquareGridGridView
                android:id="@+id/gridCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:numColumns="7"
                android:paddingHorizontal="8dp"
                android:horizontalSpacing="2dp"
                android:verticalSpacing="1dp" />
        </LinearLayout>

        <!-- ========= 周视图（保留但功能不变） ========= -->
        <LinearLayout
            android:id="@+id/paneWeek"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnWeekPrev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="‹"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/tvWeekTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnWeekNext"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="›"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="4dp">

                <LinearLayout
                    android:id="@+id/weekGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </ScrollView>
        </LinearLayout>

        <!-- ========= 年视图（保留但功能不变） ========= -->
        <LinearLayout
            android:id="@+id/paneYear"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnYearPrev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="‹"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/tvYearTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnYearNext"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="›"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:padding="0dp"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp">

                <LinearLayout
                    android:id="@+id/yearGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- ========= 下半部分：当天心情记录（可滚动，填充剩余空间） ========= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_bg_bottom"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clipChildren="false">

        <!-- 日期标题 -->
        <TextView
            android:id="@+id/tvDayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 心情记录列表（可滚动），底部padding填满与按钮之间的间隙 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDayEntries"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:paddingBottom="28dp" />
        </LinearLayout>

        <!-- 按钮在底部（不位移，可点击） -->
        <Button
            android:id="@+id/btnAddMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:text="＋ 记今天的心情"
            android:textSize="15sp"
            android:background="@drawable/btn_primary"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_margin="10dp"
            android:stateListAnimator="@null" />
    </FrameLayout>

</LinearLayout>